#!/bin/bash
# gitvm - Git account Version Manager (SSH Edition)

CONFIG_DIR="$HOME/.gitvm"
CURRENT_PROFILE_FILE="$CONFIG_DIR/current"
PROFILES_DIR="$CONFIG_DIR/profiles"
CREDENTIALS_DIR="$CONFIG_DIR/credentials"
SSH_DIR="$HOME/.ssh"
SSH_CONFIG_FILE="$SSH_DIR/config"

mkdir -p "$PROFILES_DIR"
mkdir -p "$CREDENTIALS_DIR"
mkdir -p "$SSH_DIR"

show_help() {
  cat <<'EOF'
╔════════════════════════════════════════════════════════════════╗
║                   GITVM - Git Version Manager                  ║
║          Gestiona múltiples cuentas de GitHub fácilmente       ║
╚════════════════════════════════════════════════════════════════╝

USO: gitvm [comando]

COMANDOS PRINCIPALES:
  <alias|nombre>        Cambia a la cuenta especificada
  setup                 Configura SSH y GitHub CLI (solo primera vez)
  status                Muestra cuenta activa y configuración
  ls                    Lista todas las cuentas configuradas

GESTIÓN DE CUENTAS:
  add <nombre> <email> [alias]  Agrega una nueva cuenta
  rm <alias|nombre>             Elimina una cuenta

REPOSITORIOS:
  clone <url> [dir]     Clona un repo con la cuenta activa

AYUDA:
  help                  Muestra este menú

EJEMPLOS DE USO:
  gitvm personal                 # Cambia a cuenta personal
  gitvm trabajo                  # Cambia a cuenta de trabajo
  gitvm setup                    # Configura SSH por primera vez
  gitvm add "Juan" juan@email.com trabajo
  gitvm clone git@github.com:user/repo.git

FLUJO DE TRABAJO TÍPICO:
  1. gitvm add "Nombre" email@ejemplo.com personal
  2. gitvm setup              # Genera claves SSH
  3. gitvm personal           # Activa cuenta personal
  4. git clone git@github.com:usuario/repo.git

NOTA: Después de 'gitvm setup', debes pegar las claves públicas
      en GitHub Settings → SSH Keys para cada cuenta.

EOF
}

list_profiles() {
  echo "Cuentas de Git configuradas:"
  if [ -z "$(ls -A $PROFILES_DIR 2>/dev/null)" ]; then
    echo "  No hay cuentas configuradas"
    echo ""
    echo "Para agregar una cuenta ejecuta:"
    echo "  gitvm add \"Tu Nombre\" tu@email.com personal"
  else
    current=""
    [ -f "$CURRENT_PROFILE_FILE" ] && current=$(cat "$CURRENT_PROFILE_FILE")

    for profile in "$PROFILES_DIR"/*; do
      profile_name=$(basename "$profile")
      profile_info=$(cat "$profile")
      profile_email=$(echo "$profile_info" | sed -n '2p')
      profile_alias=$(echo "$profile_info" | sed -n '3p')

      if [ "$profile_name" = "$current" ]; then
        echo -n "* $profile_name ($profile_email)"
      else
        echo -n "  $profile_name ($profile_email)"
      fi

      if [ -n "$profile_alias" ]; then
        echo " [alias: $profile_alias]"
      else
        echo ""
      fi
    done
  fi
}

show_status() {
  if [ -f "$CURRENT_PROFILE_FILE" ]; then
    current=$(cat "$CURRENT_PROFILE_FILE")
    profile_info=$(cat "$PROFILES_DIR/$current")
    profile_email=$(echo "$profile_info" | sed -n '2p')
    profile_alias=$(echo "$profile_info" | sed -n '3p')

    echo "╔════════════════════════════════════════════════════════════╗"
    echo "║              ESTADO ACTUAL DE GITVM                        ║"
    echo "╚════════════════════════════════════════════════════════════╝"
    echo ""
    echo "Cuenta activa: $current ($profile_email)"
    [ -n "$profile_alias" ] && echo "Alias: $profile_alias"
    echo ""
    echo "Configuración global de Git:"
    echo "  user.name:  $(git config --global user.name)"
    echo "  user.email: $(git config --global user.email)"
    echo ""

    # Check GitHub CLI status
    if command -v gh &>/dev/null; then
      gh_user=$(gh api user --jq '.login' 2>/dev/null || echo "No autenticado")
      echo "GitHub CLI (gh):"
      echo "  Usuario: $gh_user"
    else
      echo "GitHub CLI (gh): No instalado"
    fi
    echo ""

    # Check SSH key
    ssh_key_file="$SSH_DIR/id_ed25519_$(echo $profile_alias | tr '[:upper:]' '[:lower:]')"
    if [ -f "$ssh_key_file" ]; then
      echo "Clave SSH:"
      echo "  Archivo: $ssh_key_file"
      echo "  Estado: ✓ Configurada"
    else
      echo "Clave SSH: ✗ No configurada"
      echo "  Ejecuta 'gitvm setup' para configurar SSH"
    fi
  else
    echo "No hay cuenta activa configurada"
    echo ""
    echo "Para ver cuentas disponibles: gitvm ls"
    echo "Para agregar una cuenta: gitvm add <nombre> <email> [alias]"
  fi
}

switch_profile() {
  profile="$1"
  profile_path="$PROFILES_DIR/$profile"

  # Search by alias if not found directly
  if [ ! -f "$profile_path" ]; then
    for p in "$PROFILES_DIR"/*; do
      p_alias=$(sed -n '3p' "$p")
      if [ "$p_alias" = "$profile" ]; then
        profile_path="$p"
        profile=$(basename "$p")
        break
      fi
    done
  fi

  if [ ! -f "$profile_path" ]; then
    echo "Error: La cuenta o alias '$profile' no existe"
    echo ""
    echo "Cuentas disponibles:"
    list_profiles
    exit 1
  fi

  profile_info=$(cat "$profile_path")
  profile_name=$(echo "$profile_info" | sed -n '1p')
  email=$(echo "$profile_info" | sed -n '2p')
  profile_alias=$(echo "$profile_info" | sed -n '3p')

  # Update Git global config
  git config --global user.name "$profile_name"
  git config --global user.email "$email"

  echo "$profile" >"$CURRENT_PROFILE_FILE"
  echo "✓ Activada cuenta de Git: $profile_name ($email)"

  # Switch GitHub CLI account if available
  if command -v gh &>/dev/null; then
    if gh auth status &>/dev/null; then
      gh auth switch --user "$profile_name" 2>/dev/null && echo "✓ Cambiada cuenta de GitHub CLI a: $profile_name" || echo "  (No se pudo cambiar cuenta gh CLI - verifica con 'gh auth status')"
    fi
  fi

  # Update SSH config to use correct key for github.com
  ssh_key_name="id_ed25519_$(echo $profile_alias | tr '[:upper:]' '[:lower:]')"
  if [ ! -f "$SSH_DIR/$ssh_key_name" ]; then
    echo ""
    echo "⚠ AVISO: No hay clave SSH configurada para esta cuenta."
    echo "  Ejecuta 'gitvm setup' para configurar las claves SSH."
  else
    # Update the github.com Host entry in SSH config
    if [ -f "$SSH_CONFIG_FILE" ]; then
      # Create temporary config with updated github.com entry
      awk -v key_path="$SSH_DIR/$ssh_key_name" '
                /^Host github\.com$/ {
                    print $0
                    print "  HostName github.com"
                    print "  User git"
                    print "  IdentityFile " key_path
                    print "  AddKeysToAgent yes"
                    print "  IdentitiesOnly yes"
                    skip = 1
                    next
                }
                /^Host / && skip {
                    skip = 0
                }
                !skip {
                    print
                }
            ' "$SSH_CONFIG_FILE" >"$SSH_CONFIG_FILE.tmp"

      mv "$SSH_CONFIG_FILE.tmp" "$SSH_CONFIG_FILE"
      echo "✓ Configuración SSH actualizada para usar clave de $profile_alias"
    fi
  fi
}

add_profile() {
  profile="$1"
  email="$2"
  alias="$3"

  if [ -z "$profile" ] || [ -z "$email" ]; then
    echo "Error: Debes especificar un nombre y un email"
    echo ""
    echo "Uso: gitvm add <nombre> <email> [alias]"
    echo "Ejemplo: gitvm add \"Juan Perez\" juan@email.com personal"
    exit 1
  fi

  echo "$profile" >"$PROFILES_DIR/$profile"
  echo "$email" >>"$PROFILES_DIR/$profile"
  [ -n "$alias" ] && echo "$alias" >>"$PROFILES_DIR/$profile"

  echo "✓ Agregada nueva cuenta: $profile ($email)"
  [ -n "$alias" ] && echo "  Alias: $alias"
  echo ""
  echo "Siguiente paso:"
  echo "  1. Ejecuta 'gitvm setup' para configurar SSH"
  echo "  2. Luego ejecuta 'gitvm $alias' para activarla"
}

remove_profile() {
  profile="$1"
  profile_path="$PROFILES_DIR/$profile"

  # Search by alias if not found directly
  if [ ! -f "$profile_path" ]; then
    for p in "$PROFILES_DIR"/*; do
      p_alias=$(sed -n '3p' "$p")
      if [ "$p_alias" = "$profile" ]; then
        profile_path="$p"
        profile=$(basename "$p")
        break
      fi
    done
  fi

  if [ ! -f "$profile_path" ]; then
    echo "Error: La cuenta o alias '$profile' no existe"
    exit 1
  fi

  rm "$profile_path"
  [ "$profile" = "$(cat $CURRENT_PROFILE_FILE 2>/dev/null)" ] && rm "$CURRENT_PROFILE_FILE"

  echo "✓ Eliminada cuenta: $profile"
}

setup_ssh_keys() {
  echo "╔════════════════════════════════════════════════════════════╗"
  echo "║         CONFIGURACIÓN DE CLAVES SSH PARA GITVM             ║"
  echo "╚════════════════════════════════════════════════════════════╝"
  echo ""

  if [ -z "$(ls -A $PROFILES_DIR 2>/dev/null)" ]; then
    echo "Error: No hay cuentas configuradas todavía."
    echo ""
    echo "Primero agrega una cuenta con:"
    echo "  gitvm add <nombre> <email> [alias]"
    exit 1
  fi

  # Backup SSH config if exists
  if [ -f "$SSH_CONFIG_FILE" ]; then
    cp "$SSH_CONFIG_FILE" "$SSH_CONFIG_FILE.backup.$(date +%Y%m%d_%H%M%S)"
    echo "✓ Backup de ~/.ssh/config creado"
  fi

  # Start SSH config with base settings
  cat >"$SSH_CONFIG_FILE" <<EOF
# gitvm - GitHub SSH Configuration
# Generated on $(date)

Host github.com
  AddKeysToAgent yes
  IdentitiesOnly yes

EOF

  for profile in "$PROFILES_DIR"/*; do
    profile_name=$(basename "$profile")
    profile_info=$(cat "$profile")
    profile_username=$(echo "$profile_info" | sed -n '1p')
    profile_email=$(echo "$profile_info" | sed -n '2p')
    profile_alias=$(echo "$profile_info" | sed -n '3p')

    if [ -z "$profile_alias" ]; then
      echo "⚠ Saltando $profile_name (no tiene alias configurado)"
      continue
    fi

    key_name="id_ed25519_$(echo $profile_alias | tr '[:upper:]' '[:lower:]')"
    key_path="$SSH_DIR/$key_name"

    echo ""
    echo "──────────────────────────────────────────────────────────"
    echo "Configurando cuenta: $profile_username ($profile_alias)"
    echo "──────────────────────────────────────────────────────────"

    # Generate SSH key if doesn't exist
    if [ ! -f "$key_path" ]; then
      echo "Generando clave SSH..."
      ssh-keygen -t ed25519 -C "$profile_email" -f "$key_path" -N ""
      chmod 600 "$key_path"
      chmod 644 "$key_path.pub"
      echo "✓ Clave SSH generada: $key_name"
    else
      echo "✓ Clave SSH ya existe: $key_name"
    fi

    # Add to SSH agent
    ssh-add "$key_path" 2>/dev/null && echo "✓ Clave agregada al SSH agent"

    # Add to SSH config
    cat >>"$SSH_CONFIG_FILE" <<EOF
Host github-$profile_alias
  HostName github.com
  User git
  IdentityFile $key_path
  IdentitiesOnly yes

EOF

    # Copy public key to clipboard
    if command -v pbcopy &>/dev/null; then
      cat "$key_path.pub" | pbcopy
      echo ""
      echo "✓ Clave pública COPIADA AL PORTAPAPELES"
      echo ""
      echo "AHORA DEBES:"
      echo "  1. Ve a: https://github.com/settings/ssh/new"
      echo "  2. Pega la clave (Cmd+V)"
      echo "  3. Dale un nombre: 'Mac - $profile_alias'"
      echo "  4. Haz clic en 'Add SSH key'"
      echo ""
      read -p "Presiona ENTER cuando hayas agregado la clave en GitHub..."

      # Verify SSH connection
      echo ""
      echo "Verificando conexión SSH..."
      if ssh -T git@github.com -i "$key_path" 2>&1 | grep -q "successfully authenticated"; then
        echo "✓ Conexión SSH exitosa para $profile_alias"
        touch "$CREDENTIALS_DIR/$profile_name"
      else
        echo "⚠ No se pudo verificar la conexión. Verifica que hayas agregado la clave en GitHub."
      fi
    else
      echo ""
      echo "Copia manualmente esta clave pública y agrégala en GitHub:"
      echo ""
      cat "$key_path.pub"
      echo ""
      echo "Ve a: https://github.com/settings/ssh/new"
      read -p "Presiona ENTER cuando hayas agregado la clave..."
    fi
  done

  echo ""
  echo "╔════════════════════════════════════════════════════════════╗"
  echo "║            CONFIGURACIÓN SSH COMPLETADA                    ║"
  echo "╚════════════════════════════════════════════════════════════╝"
  echo ""
  echo "Siguiente paso: Autenticar con GitHub CLI"
  echo ""

  # Setup GitHub CLI
  if command -v gh &>/dev/null; then
    echo "Configurando GitHub CLI para múltiples cuentas..."
    echo ""
    echo "IMPORTANTE: Debes autenticar cada cuenta por separado."
    echo ""

    for profile in "$PROFILES_DIR"/*; do
      profile_name=$(basename "$profile")
      profile_info=$(cat "$profile")
      profile_username=$(echo "$profile_info" | sed -n '1p')
      profile_alias=$(echo "$profile_info" | sed -n '3p')

      [ -z "$profile_alias" ] && continue

      echo "──────────────────────────────────────────────────────────"
      echo "Autenticando cuenta: $profile_username ($profile_alias)"
      echo "──────────────────────────────────────────────────────────"
      echo ""
      read -p "¿Deseas autenticar esta cuenta ahora? (s/n): " response

      if [[ "$response" == "s" || "$response" == "S" ]]; then
        echo ""
        echo "Ejecuta: gh auth login"
        echo "  - Elige: GitHub.com"
        echo "  - Protocolo: SSH"
        echo "  - Clave SSH: Usa la existente ($SSH_DIR/id_ed25519_$profile_alias)"
        echo "  - Autenticación: Login with a web browser"
        echo ""
        gh auth login
      else
        echo "Puedes autenticar más tarde con: gh auth login"
      fi
      echo ""
    done

    echo "✓ GitHub CLI configurado"
  else
    echo "⚠ GitHub CLI (gh) no está instalado."
    echo "  Para instalarlo: brew install gh"
    echo "  Luego ejecuta: gh auth login para cada cuenta"
  fi

  echo ""
  echo "╔════════════════════════════════════════════════════════════╗"
  echo "║                ¡CONFIGURACIÓN COMPLETA!                    ║"
  echo "╚════════════════════════════════════════════════════════════╝"
  echo ""
  echo "Ya puedes cambiar entre cuentas con:"
  echo "  gitvm personal"
  echo "  gitvm trabajo"
  echo ""
  echo "Verifica el estado con: gitvm status"
}

clone_with_profile() {
  repo_url="$1"
  repo_dir="$2"

  if [ -z "$repo_url" ]; then
    echo "Error: Debes especificar la URL del repositorio"
    echo ""
    echo "Uso: gitvm clone <url> [directorio]"
    echo "Ejemplo: gitvm clone git@github.com:user/repo.git"
    exit 1
  fi

  # If no directory provided, use default from repo name
  if [ -z "$repo_dir" ]; then
    repo_dir=$(basename "$repo_url" .git)
  fi

  # Check if there's an active profile
  if [ ! -f "$CURRENT_PROFILE_FILE" ]; then
    echo "⚠ AVISO: No hay cuenta activa."
    echo "  Ejecuta 'gitvm <alias>' para activar una cuenta primero."
    echo ""
    read -p "¿Deseas continuar de todos modos? (s/n): " response
    if [[ "$response" != "s" && "$response" != "S" ]]; then
      exit 1
    fi
  fi

  # Clone repository
  echo "Clonando repositorio..."
  git clone "$repo_url" "$repo_dir"

  if [ $? -ne 0 ]; then
    echo "Error: No se pudo clonar el repositorio"
    exit 1
  fi

  # Configure local account if there's an active profile
  if [ -f "$CURRENT_PROFILE_FILE" ]; then
    current=$(cat "$CURRENT_PROFILE_FILE")
    profile_info=$(cat "$PROFILES_DIR/$current")
    profile_name=$(echo "$profile_info" | sed -n '1p')
    profile_email=$(echo "$profile_info" | sed -n '2p')

    cd "$repo_dir"
    git config --local user.name "$profile_name"
    git config --local user.email "$profile_email"
    echo "✓ Configurada cuenta local: $profile_name ($profile_email)"
  fi

  echo "✓ Repositorio clonado exitosamente en: $repo_dir"
}

# Main command dispatcher
case "$1" in
"setup")
  setup_ssh_keys
  ;;
"clone")
  clone_with_profile "$2" "$3"
  ;;
"ls")
  list_profiles
  ;;
"status")
  show_status
  ;;
"add")
  add_profile "$2" "$3" "$4"
  ;;
"rm")
  remove_profile "$2"
  ;;
"help" | "--help" | "-h")
  show_help
  ;;
"")
  show_help
  ;;
*)
  switch_profile "$1"
  ;;
esac

exit 0
